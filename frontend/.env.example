# ═══════════════════════════════════════════════════════════════════════════════
# Ultra Tasker — Frontend environment (Next.js 14)
#
# Copy to .env and fill in every value:   copy .env.example .env
# Restart `npm run dev` after any change — Next.js reads .env only at boot.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Backend API ────────────────────────────────────────────────────────────────
# Base URL of the Express API. Must match PORT in backend/.env and be listed in
# the backend's CORS_ORIGIN (backend verifies the browser origin, not this URL).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ─── Firebase client config ─────────────────────────────────────────────────────
# Firebase Console → Project settings → General → "Your apps" → Web app (</>)
# → SDK setup and configuration → Config. Copy each value below.
# These identify the app publicly — they are safe to ship to the browser;
# access is controlled by Firebase Auth + backend owner checks, not secrecy.
#
# Also enable the sign-in providers you want:
#   Firebase Console → Authentication → Sign-in method → Email/Password and Google
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
