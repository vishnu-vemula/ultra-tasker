# ═══════════════════════════════════════════════════════════════════════════════
# Ultra Tasker — Backend environment (Express + Prisma + Firebase Admin)
#
# Copy to .env and fill in every value:   copy .env.example .env
# Needs: PostgreSQL running, a Firebase project, and a service-account key.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the frontend dev server).
# Next.js dev runs on http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Create the DB first:   createdb ultra_tasker   (or any tool of your choice)
# Local:    postgresql://postgres:<password>@localhost:5432/ultra_tasker
# Neon/Supabase (add ?sslmode=require):
#           postgresql://user:pass@host/db?sslmode=require
# Then apply the schema:  npx prisma migrate dev
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/ultra_tasker

# ─── Firebase Admin (server side) ───────────────────────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Use exactly ONE of the options below (A beats B beats C):
#
# Option A (recommended): paste the entire service-account JSON as ONE line.
# Keep the \n escapes inside private_key exactly as downloaded.
# FIREBASE_SERVICE_ACCOUNT_KEY={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
#
# Option B: discrete values from the same JSON (keep the \n escapes in the key).
#   FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#
# Option C: leave all empty and set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Bootstrap & limits ─────────────────────────────────────────────────────────
# Comma-separated emails granted the ADMIN role on first login
# (promotes only — to demote, change the role in the admin UI).
BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Owner of the demo data. Set to your Firebase UID (visible after first login at
# GET /api/v1/auth/session), then run:  npm run db:seed
SEED_OWNER_UID=
# Max API requests per 15 min per IP
RATE_LIMIT_MAX=300
