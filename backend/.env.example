# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# Local:    postgresql://postgres:postgres@localhost:5432/ultra_tasker
# Neon/Supabase (add ?sslmode=require): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ultra_tasker

# ─── Firebase Admin (server side) ──────────────────────────────────────────
# Option A (recommended): paste the entire service-account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_KEY={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Option B: discrete values (keep the \n escapes in the private key)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Option C: leave all empty and set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Bootstrap & limits ────────────────────────────────────────────────────
# Comma-separated emails that are granted the ADMIN role on first login
BOOTSTRAP_ADMIN_EMAILS=you@example.com
# Seed ownership: set to your Firebase UID (after first login) then run `npm run db:seed`
SEED_OWNER_UID=
# Max requests per 15 min per IP
RATE_LIMIT_MAX=300
